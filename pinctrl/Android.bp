cc_library_static {
    name: "libgpiolib",
    srcs: [
        "gpiochip_bcm2712.c",
        "gpiochip_bcm2835.c",
        "gpiochip_firmware.c",
        "gpiochip_rp1.c",
        "gpiolib.c",
        "library_gpiochips.c",
        "util.c",
    ],
    cflags: [
        "-DLIBRARY_BUILD=1",
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}

cc_binary {
    name: "pinctrl",
    vendor: true,
    srcs: [
        "pinctrl.c",
    ],
    static_libs: [
        "libgpiolib",
    ],
}
